# ─── World Developer Portal (https://developer.world.org) ───────────────────
# App id (used by MiniKit + IDKit). Create a Mini App, enable World ID 4.0.
WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Relying-party id from "Enable World ID 4.0"
WORLD_RP_ID=rp_xxxxxxxxxxxxxxxx
# RP signing key — SERVER ONLY SECRET, returned once by the portal. Never NEXT_PUBLIC_.
RP_SIGNING_KEY=
# production (real World App) | staging (simulator.worldcoin.org)
WORLD_ID_ENV=production
# Developer Portal API key — used to verify MiniKit pay transactions
DEV_PORTAL_API_KEY=

# ─── Game ────────────────────────────────────────────────────────────────────
SEASON_ID=1
ENTRY_FEE_USDC=1
# PrizePool contract on World Chain (whitelist it in the portal for Pay)
PRIZE_POOL_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Secrets (generate with: openssl rand -hex 32) ───────────────────────────
AUTH_SECRET=
GAME_SECRET=
ADMIN_SECRET=

# ─── Storage ─────────────────────────────────────────────────────────────────
# Local SQLite file, or a Turso/libSQL URL in production (libsql://...)
DATABASE_URL=file:./data/world-game.db
DATABASE_AUTH_TOKEN=

# ─── On-chain payouts (optional) ─────────────────────────────────────────────
# Operator allowed to call PrizePool.payout; if unset, claims stay "pending".
OPERATOR_PRIVATE_KEY=
WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public

# ─── Demo (judging outside World App) ────────────────────────────────────────
# Enables throwaway sign-in, simulated World ID and simulated payments.
DEMO_MODE=false
